# Database (Supabase Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/legendsboost"
DIRECT_URL="postgresql://postgres:password@localhost:5432/legendsboost"

# NextAuth
AUTH_SECRET="your-auth-secret-here"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Google OAuth callback URL (development):
# http://localhost:3000/api/auth/callback/google
# For production:
# https://YOUR_DOMAIN/api/auth/callback/google

# Supabase (Realtime + Postgres)
# NEXT_PUBLIC_ variables are safe to expose to the browser.
# Non-prefixed variables are server-only and must never reach the client.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Server-only: Supabase project JWT secret (Dashboard -> Settings -> API -> JWT secret).
# Used to sign short-lived Realtime JWTs for the Auth.js -> Supabase Realtime bridge.
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"
# Server-only: Supabase service-role key for privileged server operations.
# REQUIRED for live chat: the server publishes Realtime broadcasts with it.
# Without it messages are still saved, but other participants only see them
# after a refresh.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
# Optional server-only alias. Defaults to NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Riot Games API (server-only; never prefix with NEXT_PUBLIC_).
# Holding a key does NOT enable live Riot data. Riot policy forbids public
# products on development/personal keys, and LegendsBoost's business model must
# pass Riot policy review first. See docs/ORDER-WORKSPACE.md.
# Canonical name. The old name RIOT_LOL_API_KEY is still read as a fallback.
RIOT_API_KEY=your_riot_development_api_key
# development | personal | production (sets the shared rate limits too).
# Development keys deactivate every 24 hours: a 403 in the server log
# (kind "forbidden") usually means the key must be regenerated.
RIOT_API_KEY_TIER=development
# Optional: override the app rate limits ("max:windowSeconds,..."), e.g. the
# values in your key's X-App-Rate-Limit header. 80% of each is used.
# RIOT_RATE_LIMITS=20:1,100:120
# Set to "true" ONLY after Riot has approved this product for Account-V1,
# League-V4 and Match-V5 use (requires a production key).
RIOT_PRODUCT_APPROVED=false
# Local testing only: lets a development key fetch Riot data when
# NODE_ENV !== "production". Ignored in production builds.
RIOT_ALLOW_DEV_KEY_LOCAL=false

# Stripe payments (TEST MODE for development and staging).
# Server-only secrets: never prefix them with NEXT_PUBLIC_.
STRIPE_SECRET_KEY="sk_test_YOUR_KEY"
# Signing secret of the webhook endpoint POST /api/webhooks/stripe
# (Dashboard -> Developers -> Webhooks, or `stripe listen` for local work).
STRIPE_WEBHOOK_SECRET="whsec_YOUR_KEY"
# Browser-safe publishable key (currently unused: hosted Checkout redirects).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_KEY"
# Live keys (sk_live_/rk_live_) and live-mode webhook events are REFUSED
# unless this is set to "true" deliberately in production.
STRIPE_LIVE_MODE_ENABLED="false"

# Absolute public URL of this deployment, used for Stripe success/cancel
# redirects (never derived from request headers). Falls back to NEXTAUTH_URL.
# NextAuth base URL. Production only (e.g. https://hoodiz.net); leave unset locally.
# NEXTAUTH_URL=""
APP_URL="http://localhost:3000"

# Server-only: AES-256-GCM key that encrypts customer game-account logins.
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different key per environment and keep it out of the database.
ACCOUNT_CREDENTIALS_KEY="YOUR_BASE64_32_BYTE_KEY"

# Scheduled jobs (Vercel Cron -> /api/cron/<job>). Vercel sends it as a Bearer
# token automatically when set in the project. Random, at least 32 characters.
CRON_SECRET="YOUR_RANDOM_CRON_SECRET"

# Error monitoring (Sentry). Leave empty to disable. Server and browser DSN
# are usually the same project DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# Email (Resend): password reset and email confirmation.
# Without these, emails are not sent (in development the link is logged).
RESEND_API_KEY=""
EMAIL_FROM="LegendsBoost <no-reply@your-domain.com>"

# Database pool per server instance: 2 for serverless (default), 10 on an
# always-on server (Railway, VPS).
# DATABASE_POOL_MAX="10"

# Set to "true" to log Content-Security-Policy violations without blocking.
# CSP_REPORT_ONLY="true"
