'use client'

import type { GameDefinition } from '@/types/catalog'
import type { GameServiceOffer } from '@/types/catalog'
import type { ServiceTemplate } from '@/types/catalog'
import { cn } from '@/lib/utils'
import { ArrowRight, Trophy, Target, FileText, Star, Gamepad2, Medal, ShieldCheck, User } from 'lucide-react'
import Link from 'next/link'

const iconMap: Record<string, any> = {
  'rank-boost': Trophy,
  'win-boost': Target,
  'placement-boost': FileText,
  'arena-boost': Star,
  'normal-matches': Gamepad2,
  'champion-mastery': Medal,
  'unrated-matches': ShieldCheck,
  'double-up-boost': User,
}

interface ServiceCardProps {
  offer: GameServiceOffer
  template: ServiceTemplate
  game: GameDefinition
  accent?: string
}

export function ServiceCard({
  offer,
  template,
  game,
  accent = '#8b5cf6',
}: ServiceCardProps) {
  const Icon = (offer as any).icon || (template as any).icon || iconMap[offer.serviceSlug] || iconMap[template.slug]

  return (
    <article
      className={cn(
        'group relative flex h-full flex-col overflow-hidden rounded-xl border border-white/10 bg-[#111319] transition-all',
        'hover:border-white/20 hover:bg-[#14161e]',
        'focus-within:border-violet-400 focus-within:ring-2 focus-within:ring-violet-400/40',
      )}
    >
      <div
        className="absolute left-0 top-0 h-1 w-full"
        style={{ backgroundColor: accent }}
        aria-hidden
      />
      <div className="flex flex-1 flex-col p-5">
        <div className="flex items-start justify-between gap-3">
          <span
            className="grid size-10 shrink-0 place-items-center rounded-lg"
            style={{ backgroundColor: `${accent}22`, color: accent }}
            aria-hidden
          >
            {Icon ? <Icon className="size-5" /> : <span className="size-5">{template.title.charAt(0)}</span>}
          </span>
        </div>

        <h3 className="mt-4 text-lg font-semibold tracking-tight text-white">
          {offer.title ?? template.title}
        </h3>
        <p className="mt-2 text-sm leading-5 text-zinc-400">
          {offer.description ?? template.description}
        </p>

        <div className="mt-4 flex items-center gap-2 text-xs text-zinc-500">
          <span className="rounded-md bg-white/5 px-2 py-1">{template.category}</span>
          <span className="text-zinc-600">{game.name}</span>
        </div>

        <div className="mt-auto pt-5">
          <Link
            href={`/games/${game.slug}/services/${offer.serviceSlug}`}
            className="inline-flex items-center gap-2 text-sm font-semibold text-white transition-colors hover:text-violet-300 focus:outline-none"
            aria-label={`View details for ${offer.title ?? template.title}`}
          >
            View details
            <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" />
          </Link>
        </div>
      </div>
    </article>
  )
}
